[Unit]
Description=Apply v4l2 camera controls from config.yaml
Documentation=file:///home/admin/vision/camera/README.md
# The controls live on the device, not on disk, so they are lost on every boot
# and every replug. This restores them.
#
# Deliberately NOT ordered before photonvision. PhotonVision imposes its own
# pipeline settings when it opens the camera, so racing it would achieve
# nothing; this covers the window before it starts and any tool that uses the
# camera directly.
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/admin/vision/camera
# The script waits for USB enumeration itself rather than depending on a
# .device unit, which does not exist until udev has seen the camera and would
# make this unit fail on a boot where the camera is unplugged.
ExecStart=/usr/bin/python3 /home/admin/vision/camera/src/vd.py apply --wait 30
# A camera that is absent at boot is worth recording, not worth failing over -
# the same reasoning as the health monitor not depending on the network.
SuccessExitStatus=0 2

[Install]
WantedBy=multi-user.target
